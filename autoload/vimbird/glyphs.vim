def Build(height: number): list<number>
  var result = repeat([0], 128)
  for code in range(128)
    var char = nr2char(code)
    var full = get(patterns, char, patterns['?'])
    var narrow = get(compact, char, full[0] .. full[2] .. full[4])
    var pattern = full
    if height == 2
      pattern = narrow[0] .. narrow[2]
      # Keep punctuation whose stroke is in the middle row.
      if pattern ==# '00'
        pattern = narrow[1] .. '0'
      endif
    elseif height == 3
      pattern = narrow
    elseif height == 4
      pattern = full[0 : 2] .. full[4]
    endif
    result[code] = Pack(pattern)
  endfor
  return result
enddef

