def Pack(pattern: string): number
  var result = 0
  for digit in str2list(pattern)
    result = (result << 8) + ((digit - 48) << 1)
  endfor
  return result
enddef

# A separate three-row alphabet retains letter shapes and punctuation at
# the common dense size. Ascenders and descenders share the compact baseline.
